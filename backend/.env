DEBUG=True
SECRET_KEY=django-insecure-red-estampacion-dev-key-change-in-production
ALLOWED_HOSTS=127.0.0.1,localhost

# sqlite (recomendado para desarrollo local rápido)
DB_ENGINE=sqlite

# Para usar MySQL cambia DB_ENGINE=mysql y completa:
